<%- include('../partials/header') %>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-route text-primary me-2"></i>Manage Routes
        </h1>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRouteModal">
            <i class="fas fa-plus me-2"></i>Add New Route
        </button>
    </div>

    <!-- Routes List -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">All Routes</h6>
            <div class="input-group w-50">
                <input type="text" class="form-control" id="searchRoutes" placeholder="Search routes...">
                <button class="btn btn-outline-secondary" type="button" id="searchBtn">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="routesTable">
                    <thead class="table-light">
                        <tr>
                            <th>Route Name</th>
                            <th>Stops</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="routesTableBody">
                        <!-- Routes will be loaded via JavaScript -->
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2 mb-0">Loading routes...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <nav aria-label="Page navigation" class="mt-4" id="paginationContainer">
                <!-- Pagination will be added here -->
            </nav>
        </div>
    </div>
</div>

<!-- Add/Edit Route Modal -->
<div class="modal fade" id="routeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add New Route</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="routeForm">
                <div class="modal-body">
                    <input type="hidden" id="routeId" name="id">
                    
                    <!-- Basic Info -->
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label for="routeName" class="form-label">Route Name *</label>
                                <input type="text" class="form-control" id="routeName" name="name" required>
                                <div class="invalid-feedback">Please provide a route name.</div>
                            </div>
                            <div class="form-group">
                                <label for="routeDescription" class="form-label">Description</label>
                                <textarea class="form-control" id="routeDescription" name="description" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header py-2 bg-light">
                                    <h6 class="mb-0">Route Summary</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Total Stops:</span>
                                        <strong id="totalStops">0</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted">Estimated Duration:</span>
                                        <strong id="totalDuration">0 min</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Status:</span>
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input" type="checkbox" id="routeStatus" name="isActive" checked>
                                            <label class="form-check-label" for="routeStatus">
                                                <span class="badge bg-success" id="statusBadge">Active</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Map and Stops -->
                    <div class="row">
                        <div class="col-md-8">
                            <div class="card h-100">
                                <div class="card-header py-2 bg-light d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">Route Map</h6>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" id="fitBoundsBtn" title="Fit to route">
                                            <i class="fas fa-compress-arrows-alt"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="addStopBtn">
                                            <i class="fas fa-plus me-1"></i> Add Stop
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-0" style="min-height: 400px;">
                                    <div id="map" style="height: 400px; width: 100%;"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100">
                                <div class="card-header py-2 bg-light">
                                    <h6 class="mb-0">Stops List</h6>
                                </div>
                                <div class="card-body p-0">
                                    <div id="stopsList" class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                                        <div class="text-center py-5 text-muted" id="noStopsMessage">
                                            <i class="fas fa-map-marker-alt fa-3x mb-3"></i>
                                            <p>No stops added yet.<br>Click "Add Stop" or click on the map to add stops.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="saveRouteBtn">
                        <span class="spinner-border spinner-border-sm d-none" id="saveSpinner" role="status" aria-hidden="true"></span>
                        Save Route
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Stop Details Modal -->
<div class="modal fade" id="stopModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Stop Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="stopForm">
                <input type="hidden" id="stopId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="stopName" class="form-label">Stop Name *</label>
                        <input type="text" class="form-control" id="stopName" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="stopLat" class="form-label">Latitude</label>
                                <input type="number" class="form-control" id="stopLat" step="0.000001" disabled>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="stopLng" class="form-label">Longitude</label>
                                <input type="number" class="form-control" id="stopLng" step="0.000001" disabled>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="stopAddress" class="form-label">Address</label>
                        <input type="text" class="form-control" id="stopAddress">
                    </div>
                    <div class="mb-3">
                        <label for="stopEstimatedTime" class="form-label">Estimated Time from Start (minutes) *</label>
                        <input type="number" class="form-control" id="stopEstimatedTime" min="0" required>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="stopIsActive" checked>
                        <label class="form-check-label" for="stopIsActive">Active Stop</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this route? This action cannot be undone.</p>
                <p class="text-danger"><strong>Warning:</strong> This will affect all buses assigned to this route.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <span class="spinner-border spinner-border-sm d-none" id="deleteSpinner" role="status" aria-hidden="true"></span>
                    Delete Route
                </button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

